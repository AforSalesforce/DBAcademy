# DBAcademy Environment Variables
# Copy this to .env.local and fill in values

# Supabase — get these from your project's Settings > API
# https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: Analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Server-only — required for Stripe webhooks (Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create Products/Prices in the Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_INSTITUTION_MONTHLY=price_...
STRIPE_PRICE_INSTITUTION_ANNUAL=price_...

# Used for Stripe redirect URLs in production (falls back to request origin)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
