# DBAcademy Environment Variables
# Copy this to .env.local and fill in values

# Master switch for accounts, cloud sync, payments and server-side code
# execution (Java/C/C++/Go). Off unless set to exactly "true": the app then
# runs as a browser-only learning tool and every Supabase/Stripe path is
# disabled on the server. Everything below is only read when this is on.
# ACCOUNTS_ENABLED=true

# Supabase — get these from your project's Settings > API Keys
# https://supabase.com/dashboard
# All Supabase settings are server-only (no NEXT_PUBLIC_ prefix): the browser
# never talks to Supabase directly, only to this app's own routes.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional: Analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Server-only — required for Stripe webhooks (Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create Products/Prices in the Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_INSTITUTION_MONTHLY=price_...
STRIPE_PRICE_INSTITUTION_ANNUAL=price_...

# Public URL of the site — used for Stripe redirects and auth email links
# (falls back to the request's origin). Server-only.
# APP_URL=https://yourdomain.com

# Judge0 — server-side execution for Java/C/C++/Go (JS/Python run in-browser).
# Leave JUDGE0_API_URL unset to use the RapidAPI CE host; omit the key if self-hosting.
# JUDGE0_API_URL=https://judge0.example.com
# JUDGE0_API_KEY=

# Local dev only: allow server-side code execution without Supabase auth.
# Ignored when NODE_ENV=production (incl. Vercel previews).
# ALLOW_ANONYMOUS_CODE_EXEC=true
